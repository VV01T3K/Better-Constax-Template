{
	"editor.tabSize": 3,
	"files.exclude": {
		"**/.turbo/": true,
		"**/.tanstack/": true,
		// "node_modules/": true,
		"AGENTS.md": true,
		".agents/": true,
		".cursor/": true
	},
	"tailwind-fold.autoFold": false,
	"css.lint.unknownAtRules": "ignore",
	"files.watcherExclude": {
		"**/routeTree.gen.ts": true,
		".claude/**": true,
		".agents/**": true,
		".cursor/**": true
	},
	"search.exclude": {
		"**/routeTree.gen.ts": true,
		"**/bun.lock": true,
		"**/_generated/**": true,
		"**/betterAuth/generatedSchema.ts": true,
		".claude/**": true,
		".agents/**": true,
		".cursor/**": true
	},
	"files.readonlyInclude": {
		"**/routeTree.gen.ts": true,
		"**/bun.lock": true,
		"**/_generated/**": true,
		"**/betterAuth/generatedSchema.ts": true,
		".claude/**": true,
		".agents/**": true,
		".cursor/**": true
	},
	"editor.formatOnSave": true,
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json5]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[yaml]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[html]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[css]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[markdown]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[toml]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"files.associations": {
		"package.json": "jsonc"
	},
	"oxc.typeAware": true,
	"oxc.fixKind": "safe_fix_or_suggestion"
}
