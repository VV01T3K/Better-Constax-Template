{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["ES2021", "dom"],
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"allowJs": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true
	}
}
