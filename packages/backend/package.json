{
	"name": "@repo/backend",
	"private": true,
	"type": "module",
	"exports": {
		"./convex/_generated/api": "./convex/_generated/api.js",
		"./convex/_generated/dataModel": "./convex/_generated/dataModel.d.ts",
		"./convex/_generated/server": "./convex/_generated/server.js",
		"./convex/*": "./convex/*",
		"./schemas": "./convex/schemas/index.ts"
	},
	"scripts": {
		"dev": "convex dev",
		"lint": "oxlint -c .oxlintrc.json --type-aware --type-check --fix convex",
		"format": "oxfmt convex",
		"check": "oxfmt convex && oxlint -c .oxlintrc.json --type-aware --type-check --fix convex && tsgo --noEmit -p convex/tsconfig.json",
		"auth:generate": "cd convex/betterAuth && bunx @better-auth/cli generate --output ./generatedSchema.ts -y",
		"convex:env": "convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32) && convex env set SITE_URL http://localhost:3000 && convex env set BETTER_AUTH_ADMIN_EMAILS admin@gmail.com"
	},
	"dependencies": {
		"@convex-dev/better-auth": "0.10.11",
		"@repo/typescript-config": "workspace:*",
		"better-auth": "^1.4.18",
		"convex": "^1.32.0",
		"convex-helpers": "^0.1.113",
		"hono": "^4.12.2",
		"neverthrow": "^8.2.0",
		"zod": "^4.3.6"
	}
}
