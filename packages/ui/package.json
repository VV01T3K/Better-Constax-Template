{
	"name": "@repo/ui",
	"private": true,
	"type": "module",
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./components/*": {
			"types": "./src/components/*.tsx",
			"default": "./src/components/*.tsx"
		},
		"./hooks/*": {
			"types": "./src/hooks/*.ts",
			"default": "./src/hooks/*.ts"
		},
		"./lib/*": {
			"types": "./src/lib/*.ts",
			"default": "./src/lib/*.ts"
		},
		"./styles/*": "./src/styles/*"
	},
	"scripts": {
		"lint": "oxlint --deny-warnings --type-aware --type-check",
		"format": "oxfmt",
		"fix": "oxfmt && oxlint --deny-warnings --type-aware --type-check --fix",
		"check": "oxfmt --check && bun run lint && tsgo --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.2.0",
		"@fontsource-variable/geist-mono": "^5.2.7",
		"@tanstack/react-hotkeys": "^0.4.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.577.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"shadcn": "^4.0.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/node": "^25.3.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260304.1"
	}
}
