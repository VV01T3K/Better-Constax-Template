{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": [".env"],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".output/**", "dist/**"],
			"env": ["VITE_CONVEX_URL", "VITE_CONVEX_SITE_URL", "CONVEX_DEPLOYMENT"],
			"inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
		},
		"preview": {
			"dependsOn": ["build"],
			"cache": false
		},
		"lint": {
			"outputs": []
		},
		"format": {
			"outputs": []
		},
		"check": {
			"outputs": []
		},
		"auth:generate": {
			"cache": false
		},
		"convex:env": {
			"cache": false
		}
	}
}
