{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		".env",
		".env.*",
		".env.local",
		".oxfmtrc.json",
		".oxlintrc.json",
		"apps/**/tsconfig.json",
		"packages/**/tsconfig.json",
		"package.json",
		"bun.lock"
	],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"preview": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["build"]
		},
		"convex": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".output/**", "dist/**", "build/**"],
			"env": ["CONVEX_SITE_URL", "CONVEX_URL"]
		},
		"@repo/ui#build": {
			"outputs": []
		},
		"test": {
			"outputs": []
		},
		"lint": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"check": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"format": {},
		"fix": {}
	}
}
