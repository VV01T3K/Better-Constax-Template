{
	"name": "@repo/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev --port 3000 --host",
		"build": "tsgo -noEmit && bun --bun vite build",
		"preview": "bun --bun vite preview --host",
		"test": "bun --bun vitest run",
		"test:unit": "bun --bun vitest run --project unit",
		"test:browser": "bun --bun vitest run --project browser",
		"test:watch": "bun --bun vitest",
		"test:coverage": "bun --bun vitest run --coverage",
		"lint": "bun --bun oxlint --deny-warnings --type-aware --type-check",
		"format": "oxfmt",
		"fix": "oxfmt && bun --bun oxlint --deny-warnings --type-aware --type-check --fix",
		"check": "oxfmt --check && bun lint && tsgo --noEmit"
	},
	"dependencies": {
		"@convex-dev/better-auth": "0.10.13",
		"@repo/convex": "workspace:*",
		"@repo/ui": "workspace:*",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/react-devtools": "^0.9.9",
		"@tanstack/react-form": "^1.28.4",
		"@tanstack/react-form-devtools": "^0.2.17",
		"@tanstack/react-hotkeys": "^0.4.0",
		"@tanstack/react-hotkeys-devtools": "^0.4.1",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-query-devtools": "^5.91.3",
		"@tanstack/react-router": "^1.166.6",
		"@tanstack/react-router-devtools": "^1.166.6",
		"@tanstack/react-router-ssr-query": "^1.166.6",
		"@tanstack/react-start": "^1.166.6",
		"@tanstack/router-plugin": "^1.166.6",
		"better-auth": "1.4.21",
		"better-convex": "0.10.1",
		"convex": "^1.32.0",
		"file-type": "^21.3.0",
		"lucide-react": "^0.577.0",
		"next-themes": "^0.4.6",
		"nitro": "npm:nitro-nightly@^3.0.1-20260310-164020-644b1751",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tailwindcss": "^4.2.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "^0.5.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "1.3.10",
		"@types/node": "^25.3.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"@vitest/browser-playwright": "4.0.18",
		"babel-plugin-react-compiler": "^1.0.0",
		"happy-dom": "^20.8.3",
		"vite": "^8.0.0-beta.16",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "4.1.0-beta.5"
	}
}
