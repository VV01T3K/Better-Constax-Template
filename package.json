{
	"name": "my-tanstack-app",
	"private": true,
	"workspaces": [
		"."
	],
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev --port 3000 --host",
		"build": "bun --bun vite build",
		"preview": "bun --bun run .output/server/index.mjs ",
		"lint": "oxlint --type-aware --type-check --fix",
		"format": "oxfmt",
		"check": "oxfmt && oxlint --type-aware --type-check --fix && tsgo --noEmit",
		"auth:generate": "cd convex/betterAuth && bunx @better-auth/cli generate --output ./generatedSchema.ts -y",
		"convex:env": "convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32) && convex env set SITE_URL http://localhost:3000 && convex env set BETTER_AUTH_ADMIN_EMAILS admin@gmail.com"
	},
	"dependencies": {
		"@convex-dev/better-auth": "0.10.11",
		"@convex-dev/react-query": "0.1.0",
		"@faker-js/faker": "^10.3.0",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/match-sorter-utils": "^8.19.4",
		"@tanstack/react-devtools": "^0.9.6",
		"@tanstack/react-form": "^1.28.3",
		"@tanstack/react-form-devtools": "^0.2.16",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-query-devtools": "^5.91.3",
		"@tanstack/react-router": "^1.162.4",
		"@tanstack/react-router-devtools": "^1.162.4",
		"@tanstack/react-router-ssr-query": "^1.162.4",
		"@tanstack/react-start": "^1.162.4",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.13.18",
		"@tanstack/router-plugin": "^1.162.4",
		"better-auth": "^1.4.18",
		"convex": "^1.32.0",
		"convex-helpers": "^0.1.113",
		"file-type": "^21.3.0",
		"hono": "^4.12.2",
		"lucide-react": "^0.575.0",
		"neverthrow": "^8.2.0",
		"nitro": "catalog:",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tailwindcss": "^4.2.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "^0.5.1",
		"@tanstack/eslint-plugin-query": "^5.91.4",
		"@types/bun": "^1.3.9",
		"@types/node": "^25.3.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260223.1",
		"@vitejs/plugin-react": "^5.1.4",
		"babel-plugin-react-compiler": "^1.0.0",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"oxlint-tsgolint": "^0.14.2",
		"vite": "catalog:",
		"vite-plugin-pwa": "^1.2.0",
		"web-vitals": "^5.1.0"
	},
	"packageManager": "bun@1.3.9",
	"catalog": {
		"vite": "npm:rolldown-vite@7.3.1",
		"nitro": "npm:nitro-nightly@3.0.1-20260219-081345-4df7aab2"
	}
}
