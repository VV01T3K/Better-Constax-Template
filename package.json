{
	"name": "my-tanstack-app",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev --port 3000 --host",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"postinstall": "bun verify:patches",
		"convex": "better-convex dev",
		"convex:codegen": "better-convex codegen",
		"convex:migrations:run": "mise exec -- bunx convex run migrations:run",
		"convex:migrations:run:prod": "mise exec -- bunx convex run --prod migrations:run",
		"convex:env:sync": "better-convex env sync --auth",
		"auth:schema:generate": "bunx @better-auth/cli generate --config convex/src/generated/auth.schema.config.ts --output convex/src/generated/authSchema.ts -y",
		"auth:schema:check": "bun run auth:schema:generate && git diff --exit-code -- convex/src/generated/authSchema.ts",
		"convex:env": "SITE_URL=http://localhost:3000 && convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32) && convex env set SITE_URL $SITE_URL && convex env set BETTER_AUTH_ADMIN_EMAILS admin@gmail.com && convex run generated/auth:getLatestJwks | convex env set JWKS && (grep -q '^VITE_SITE_URL=' .env.local && sed -i \"s|^VITE_SITE_URL=.*|VITE_SITE_URL=$SITE_URL|\" .env.local || printf \"\\nVITE_SITE_URL=%s\\n\" \"$SITE_URL\" >> .env.local)",
		"lint": "oxlint --type-aware --type-check --fix",
		"format": "oxfmt",
		"check": "oxfmt && oxlint --type-aware --type-check --fix && tsgo --noEmit",
		"verify:patches": "bun run scripts/verify-patches.ts"
	},
	"dependencies": {
		"@convex-dev/migrations": "^0.3.1",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/react-devtools": "^0.9.9",
		"@tanstack/react-form": "^1.28.4",
		"@tanstack/react-form-devtools": "^0.2.17",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-query-devtools": "^5.91.3",
		"@tanstack/react-router": "^1.166.2",
		"@tanstack/react-router-devtools": "^1.166.2",
		"@tanstack/react-router-ssr-query": "^1.166.2",
		"@tanstack/react-start": "^1.166.2",
		"@tanstack/router-plugin": "^1.166.2",
		"better-auth": "1.4.21",
		"better-convex": "0.9.0",
		"convex": "^1.32.0",
		"convex-helpers": "^0.1.114",
		"lucide-react": "^0.577.0",
		"nitro": "npm:nitro-nightly@^3.0.1-20260227-181935-bfbb207c",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tailwindcss": "^4.2.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.21",
		"@tanstack/devtools-vite": "^0.5.3",
		"@tanstack/eslint-plugin-query": "^5.91.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "1.3.10",
		"@types/node": "^25.3.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260304.1",
		"@vitejs/plugin-react": "^5.1.4",
		"@vitest/browser-playwright": "^4.0.18",
		"babel-plugin-react-compiler": "^1.0.0",
		"happy-dom": "^20.8.3",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.51.0",
		"oxlint-tsgolint": "^0.16.0",
		"vite": "^8.0.0-beta.16",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "4.1.0-beta.5"
	},
	"overrides": {
		"@convex-dev/better-auth": "0.10.12"
	},
	"packageManager": "bun@1.3.10",
	"patchedDependencies": {
		"@convex-dev/better-auth@0.10.12": "patches/@convex-dev%2Fbetter-auth@0.10.12.patch"
	}
}
