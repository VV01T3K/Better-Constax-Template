{
	"name": "better-constax-template",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "turbo run dev --filter=@repo/web --filter=@repo/convex",
		"dev:web": "turbo run dev --filter=@repo/web",
		"dev:convex": "turbo run dev --filter=@repo/convex",
		"build": "turbo run build --filter=@repo/web",
		"preview": "turbo run preview --filter=@repo/web",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"check": "turbo run check",
		"auth:generate": "turbo run auth:generate --filter=@repo/convex",
		"convex:env": "turbo run convex:env --filter=@repo/convex"
	},
	"devDependencies": {
		"@tanstack/eslint-plugin-query": "^5.91.4",
		"@types/bun": "^1.3.9",
		"@types/node": "^25.3.0",
		"@typescript/native-preview": "^7.0.0-dev.20260223.1",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"oxlint-tsgolint": "^0.14.2",
		"turbo": "^2.8.10"
	},
	"packageManager": "bun@1.3.9"
}
