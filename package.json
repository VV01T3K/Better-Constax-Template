{
	"name": "my-tanstack-app",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev --port 3000 --host",
		"build": "vite build",
		"preview": "vite preview",
		"postinstall": "node scripts/verify-patches.mjs",
		"convex": "better-convex dev",
		"convex:codegen": "better-convex codegen",
		"convex:env:sync": "bunx better-convex env sync --auth",
		"auth:schema:generate": "bunx @better-auth/cli generate --config convex/functions/auth.schema.config.ts --output convex/functions/authSchema.ts -y",
		"auth:schema:check": "bun run auth:schema:generate && git diff --exit-code -- convex/functions/authSchema.ts",
		"test": "vitest run --passWithNoTests",
		"convex:env": "SITE_URL=http://localhost:3000 && convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32) && convex env set SITE_URL $SITE_URL && convex env set BETTER_AUTH_ADMIN_EMAILS admin@gmail.com && convex run generated/auth:getLatestJwks | convex env set JWKS && (grep -q '^VITE_SITE_URL=' .env.local && sed -i \"s|^VITE_SITE_URL=.*|VITE_SITE_URL=$SITE_URL|\" .env.local || printf \"\\nVITE_SITE_URL=%s\\n\" \"$SITE_URL\" >> .env.local)",
		"lint": "oxlint --type-aware --type-check --fix",
		"format": "oxfmt",
		"check": "oxfmt && oxlint --type-aware --type-check --fix && tsgo --noEmit",
		"verify:patches": "node scripts/verify-patches.mjs"
	},
	"dependencies": {
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/react-devtools": "^0.9.6",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-query-devtools": "^5.91.3",
		"@tanstack/react-router": "^1.163.2",
		"@tanstack/react-router-devtools": "^1.163.2",
		"@tanstack/react-router-ssr-query": "^1.163.2",
		"@tanstack/react-start": "^1.163.2",
		"@tanstack/router-plugin": "^1.163.2",
		"better-auth": "1.4.19",
		"better-convex": "0.7.1",
		"convex": "^1.32.0",
		"convex-helpers": "^0.1.114",
		"lucide-react": "^0.575.0",
		"nitro": "npm:nitro-nightly@^3.0.1-20260226-083821-5ccf672a",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tailwindcss": "^4.2.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.19",
		"@tanstack/devtools-vite": "^0.5.1",
		"@tanstack/eslint-plugin-query": "^5.91.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.3.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260226.1",
		"@vitejs/plugin-react": "^5.1.4",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^28.1.0",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"oxlint-tsgolint": "^0.15.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.0.18"
	},
	"overrides": {
		"@convex-dev/better-auth": "0.10.12"
	},
	"packageManager": "bun@1.3.9",
	"patchedDependencies": {
		"@convex-dev/better-auth@0.10.12": "patches/@convex-dev%2Fbetter-auth@0.10.12.patch"
	}
}
