{
	"name": "my-tanstack-app",
	"private": true,
	"workspaces": [
		"."
	],
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev --port 3000 --host",
		"build": "bun --bun vite build",
		"preview": "bun --bun run .output/server/index.mjs ",
		"test": "bun --bun vitest run",
		"lint": "oxlint --type-aware --type-check --fix",
		"format": "oxfmt",
		"check": "oxfmt && oxlint --type-aware --type-check --fix && tsgo --noEmit",
		"auth:generate": "cd convex/betterAuth && bunx @better-auth/cli generate --output ./generatedSchema.ts -y",
		"convex:env": "convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32) && convex env set SITE_URL http://localhost:3000"
	},
	"dependencies": {
		"@convex-dev/better-auth": "0.10.10",
		"@convex-dev/react-query": "0.1.0",
		"@faker-js/faker": "^10.2.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/match-sorter-utils": "^8.19.4",
		"@tanstack/query-db-collection": "^1.0.22",
		"@tanstack/react-db": "^0.1.69",
		"@tanstack/react-devtools": "^0.9.4",
		"@tanstack/react-form": "^1.28.0",
		"@tanstack/react-form-devtools": "^0.2.13",
		"@tanstack/react-query": "^5.90.20",
		"@tanstack/react-query-devtools": "^5.91.3",
		"@tanstack/react-router": "^1.158.1",
		"@tanstack/react-router-devtools": "^1.158.1",
		"@tanstack/react-router-ssr-query": "^1.158.1",
		"@tanstack/react-start": "^1.158.3",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/router-plugin": "^1.158.1",
		"better-auth": "catalog:",
		"convex": "^1.31.7",
		"convex-helpers": "^0.1.111",
		"hono": "^4.11.8",
		"lucide-react": "^0.563.0",
		"nitro": "catalog:",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tailwindcss": "^4.1.18",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@hono/zod-validator": "^0.7.6",
		"@tanstack/devtools-vite": "^0.5.0",
		"@tanstack/eslint-plugin-query": "^5.91.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.8",
		"@types/node": "^25.2.1",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "catalog:",
		"@vitejs/plugin-react": "^5.1.3",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^28.0.0",
		"oxfmt": "^0.28.0",
		"oxlint": "^1.43.0",
		"oxlint-tsgolint": "^0.11.4",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"web-vitals": "^5.1.0"
	},
	"packageManager": "bun@1.3.8",
	"catalog": {
		"@typescript/native-preview": "^7.0.0-dev.20260206.1",
		"vite": "npm:rolldown-vite@7.3.1",
		"nitro": "npm:nitro-nightly@latest",
		"better-auth": "1.4.9"
	},
	"patchedDependencies": {
		"@convex-dev/better-auth@0.10.10": "patches/@convex-dev%2Fbetter-auth@0.10.10.patch"
	}
}
