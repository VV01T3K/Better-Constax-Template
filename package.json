{
	"name": "better-constax-template",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev --parallel",
		"convex": "bun run --cwd packages/convex --silent convex",
		"preview": "turbo run preview --filter=@repo/web --parallel",
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"fix": "turbo run fix",
		"check": "turbo run check",
		"verify:patches": "bun run scripts/verify-patches.ts",
		"postinstall": "bun run verify:patches"
	},
	"devDependencies": {
		"@tanstack/eslint-plugin-query": "^5.91.4",
		"@types/node": "^25.4.0",
		"@typescript/native-preview": "^7.0.0-dev.20260309.1",
		"nitro": "npm:nitro-nightly@^3.0.1-20260309-141311-a2ee33b1",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.51.0",
		"oxlint-tsgolint": "^0.16.0",
		"turbo": "^2.5.6"
	},
	"overrides": {
		"@convex-dev/better-auth": "0.10.13"
	},
	"packageManager": "bun@1.3.10",
	"patchedDependencies": {
		"@convex-dev/better-auth@0.10.13": "patches/@convex-dev%2Fbetter-auth@0.10.13.patch"
	}
}
